alias k="kubectl"
alias v="vim"
alias ls="ls --color"
alias la="ls --color -a"

install-kube-config() {
  local SOPS_AGE_KEY
  echo "Enter AGE Private Key: "
  read -rs SOPS_AGE_KEY
  mkdir -p ~/.kube ~/.talos
  SOPS_AGE_KEY="$SOPS_AGE_KEY" sops --decrypt ~/dotfiles/secrets/kube/config  > ~/.kube/config
  SOPS_AGE_KEY="$SOPS_AGE_KEY" sops --decrypt ~/dotfiles/secrets/talos/config > ~/.talos/config
  chmod 600 ~/.kube/config ~/.talos/config
  echo "Configs decrypted."
}
