#!/bin/bash

configdir=${XDG_CONFIG_HOME:-${HOME}/.config}

if [[ -f ~/.bashrc ]]; then
  . ~/.bashrc
  return 0
fi

if [[ -d "$configdir/bash" ]]; then
  [[ -f $configdir/bash/vars ]] && . $configdir/bash/completion
  [[ -f $configdir/bash/vars ]] && . $configdir/bash/vars
  [[ -f $configdir/bash/alias ]] && . $configdir/bash/alias
  [[ -f $configdir/bash/eval ]] && . $configdir/bash/eval
fi
